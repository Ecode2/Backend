# ===========================================================================
# Bookverse backend environment. Copy to /opt/bookverse/.env and fill in.
# ===========================================================================

# --- Core ------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false
ALLOWED_HOSTS=bookverse.api.ecode2.com

# --- CORS / CSRF (frontend origin) -----------------------------------------
CORS_ALLOWED_ORIGINS=https://bookverse.ecode2.com
CSRF_TRUSTED_ORIGINS=https://bookverse.ecode2.com

# --- Auth cookies (shared across the two ecode2.com subdomains) ------------
COOKIE_DOMAIN=.ecode2.com
REFRESH_COOKIE_NAME=bv_refresh
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=Lax
WS_TICKET_TTL_SECONDS=30

# --- Database (Postgres in prod) -------------------------------------------
DATABASE_URL=postgres://bookverse:CHANGE_ME@127.0.0.1:5432/bookverse
DB_SSL_REQUIRE=false           # local Postgres on the same VM needs no SSL
POSTGRES_DB=bookverse
POSTGRES_USER=bookverse
POSTGRES_PASSWORD=CHANGE_ME

# --- Redis (cache db 1, channel layer db 2) --------------------------------
CACHE_DB=redis://127.0.0.1:6379/1
CHANNEL_DB=redis://127.0.0.1:6379/2

# --- Object storage: MinIO (S3-compatible), self-hosted on the VPS ---------
AWS_STORAGE_BUCKET_NAME=bookverse
AWS_ACCESS_KEY_ID=bookverse
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_S3_ENDPOINT_URL=http://127.0.0.1:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_USE_SSL=false
AWS_S3_ADDRESSING_STYLE=path
# Public base URL for serving media (e.g. https://files.ecode2.com). Optional.
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=true
AWS_QUERYSTRING_EXPIRE=3600

# MinIO server credentials (used by install.sh to provision the service).
MINIO_ROOT_USER=bookverse
MINIO_ROOT_PASSWORD=CHANGE_ME

# --- Text-to-Speech (pluggable provider) -----------------------------------
# nvidia = NVIDIA Riva-hosted TTS (default), google = Google Cloud TTS,
# piper = local Piper engine, dummy = silent (dev)
TTS_PROVIDER=nvidia
TTS_DEFAULT_VOICE=Magpie-Multilingual.EN-US.Ray
#.Aria
TTS_DEFAULT_LANGUAGE=en-US
TTS_AUDIO_ENCODING=MP3
AUDIO_CACHE_MAX_BYTES=2147483648

# NVIDIA Riva TTS (used when TTS_PROVIDER=nvidia). NVIDIA's hosted TTS models
# (build.nvidia.com, e.g. the Magpie-TTS family) are served over gRPC, not a
# REST/OpenAI-style API -- get a free API key from build.nvidia.com ("Get API
# Key" on any model page), and copy the "function-id" shown on the specific
# TTS model's page to pick which model to use (default below is Magpie-TTS
# Multilingual). Also set TTS_DEFAULT_VOICE above to a voice from that
# model's roster (e.g. Magpie-Multilingual.EN-US.Aria).
NVIDIA_API_KEY=
NVIDIA_TTS_SERVER=grpc.nvcf.nvidia.com:443
NVIDIA_TTS_FUNCTION_ID=877104f7-e885-42b9-8de8-f6e4c6303969
NVIDIA_TTS_SAMPLE_RATE_HZ=44100

# Google TTS auth (only used when TTS_PROVIDER=google): this VPS is NOT on
# GCP, so there is no metadata server / attached service account. Create a
# service account with the "Cloud Text-to-Speech API User" role, download its
# JSON key, place it OUTSIDE the repo (e.g. /opt/bookverse/gcp-tts.json), and
# point ADC at it:
GOOGLE_APPLICATION_CREDENTIALS=/opt/bookverse/gcp-tts.json

# Local Piper engine (only used when TTS_PROVIDER=piper):
PIPER_BINARY=piper
PIPER_MODEL_PATH=/opt/bookverse/voices/en_US-amy-medium.onnx
